# ── Game server ─────────────────────────────────────────────────────────────
PORT=2567
# Public base URL of this server (share images, OpenGraph link pages)
PUBLIC_SERVER_URL=http://localhost:2567
# Public URL of the web app (challenge links, deep links)
PUBLIC_APP_URL=http://localhost:8081

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty for local dev: an embedded Postgres (PGlite) is created in apps/server/.data
# and the migrations + seed are applied automatically.
# Production: Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543)
DATABASE_URL=
# PGLITE_DIR=./.data/pglite   # or memory:// for a throwaway DB

# ── Auth ────────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API. With these set, Supabase JWTs are accepted and dev auth is off.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Dev/guest tokens issued by this server when Supabase isn't configured. Change in any shared env.
DEV_JWT_SECRET=change-me-to-a-long-random-string
# ALLOW_DEV_AUTH=true   # force-enable dev sign-in even with Supabase keys (never in production)

# ── Matchmaking ─────────────────────────────────────────────────────────────
# Optional. Without it the queue is in-memory (single instance).
REDIS_URL=

# ── Observability (optional — adapters no-op when empty) ────────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# ── Push notifications (optional) ───────────────────────────────────────────
EXPO_ACCESS_TOKEN=
