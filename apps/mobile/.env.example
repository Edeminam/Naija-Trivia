# Game server. Leave empty in dev: web uses <current host>:2567, devices use the Metro host IP :2567.
EXPO_PUBLIC_SERVER_URL=
# Public web URL of this app (challenge links)
EXPO_PUBLIC_APP_URL=

# Supabase Auth (phone OTP, Google, Apple, anonymous guests). Leave empty for local dev sign-in.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# "mock" (default) or "live" (RevenueCat on mobile / Paystack on web — adapters not yet wired)
EXPO_PUBLIC_PURCHASES=mock

# Optional observability
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
