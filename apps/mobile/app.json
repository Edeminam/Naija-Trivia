{
  "expo": {
    "name": "Naija Trivia Clash",
    "slug": "naija-trivia-clash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "naijatrivia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.naijatrivia.clash",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:naijatrivia.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.naijatrivia.clash",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "naijatrivia.app",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "naijatrivia.app",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro",
      "name": "Naija Trivia Clash",
      "shortName": "Naija Clash",
      "themeColor": "#0B0F0D",
      "backgroundColor": "#0B0F0D"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0FA958"
        }
      ],
      "expo-apple-authentication",
      "expo-font",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0F0D",
    "description": "Real-time Nigerian trivia battles. Rep your state."
  }
}
